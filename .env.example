# ==============================================================================
# Makina Maps Modern - Configuration
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=makina-maps

# External HTTP Ports
PORT=8080
NGINX_STATUS_PORT=8082

# PostgreSQL / PostGIS Settings
POSTGRES_DB=openmaptiles
POSTGRES_USER=openmaptiles
POSTGRES_PASSWORD=openmaptiles
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PGPASSWORD=openmaptiles

# OpenMapTiles Toolchain Version
TOOLS_VERSION=latest
POSTGIS_IMAGE=openmaptiles/postgis

# Tile Schema & Server
TILESET_FILE=/tileset/schema/openmaptiles.yaml
PPORT=8090
OMT_HOST=http://localhost:8080

# Zoom Levels & Area Defaults
MIN_ZOOM=0
MAX_ZOOM=14
AREA=monaco
PROVIDER=geofabrik

# Concurrency & Performance
COPY_CONCURRENCY=4
MAX_PARALLEL_PSQL=4
DIFF_MODE=true

# Cache Configuration
CACHE_KEYS_ZONE_SIZE=50m
CACHE_MAX_SIZE=20g
