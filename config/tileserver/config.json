{
  "options": {
    "paths": {
      "root": "/data",
      "fonts": "fonts",
      "styles": "styles",
      "mbtiles": "data"
    },
    "domains": [
      "localhost:8080",
      "127.0.0.1:8080"
    ],
    "formatQuality": {
      "jpeg": 85,
      "webp": 90
    },
    "maxScaleFactor": 3,
    "maxSize": 2048,
    "pbfAlias": "pbf",
    "serveAllFonts": true,
    "serveAllStyles": true,
    "serveStaticMaps": true,
    "tileMargin": 10
  },
  "styles": {
    "bright": {
      "style": "osm-bright/style.json",
      "serve_rendered": true
    },
    "liberty": {
      "style": "osm-liberty/style.json",
      "serve_rendered": true
    },
    "basic": {
      "style": "basic/style.json",
      "serve_rendered": true
    }
  },
  "data": {
    "v3": {
      "mbtiles": "export/tiles.mbtiles"
    }
  }
}
